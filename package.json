{
  "name": "funkycommerce-headless-theme",
  "private": true,
  "version": "1.2.11",
  "description": "Tailwind/build tooling for the FunkyCommerce Headless WordPress theme's native frontend assets (block templates, template parts, loader, and Spotify slot).",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/theme-source.css -o ./assets/dist/theme.css --minify",
    "build:js": "esbuild ./assets/js/theme.js --bundle --minify --target=es2018 --outfile=./assets/dist/theme.js",
    "build": "npm run build:css && npm run build:js && npm run sync-parts",
    "watch:css": "tailwindcss -i ./assets/css/theme-source.css -o ./assets/dist/theme.css --watch",
    "sync-parts": "node ./build/sync-template-assets.mjs",
    "lint:php": "node ./build/lint-php.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "php-parser": "^3.7.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10"
  }
}
